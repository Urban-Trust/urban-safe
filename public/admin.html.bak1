<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Urban Safe - Panel de Control</title>
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/styles/admin.css">
</head>
<body>

        <nav class="navbar">
            <div class="container nav-inner">
                <a href="#" class="brand" aria-label="Urban Safe">
                    <img class="brand-logo" src="assets/images/UrbanSafe-Logo-Horizontal-Sin Fondo.png" alt="Urban Safe" />
                </a>

                <ul class="menu">
                    <li><a href="index.html">Inicio</a></li>
                    <li><a href="map.html">Mapa</a></li>
                    <li><a href="chat.html">Chats</a></li>
                    <li><a href="reports.html">Incidentes</a></li>
                </ul>

                <a href="login.html" class="login-link">
                    <span>Iniciar sesión</span>
                </a>
            </div>
        </nav>

    <main class="main-content container">
        <div class="dashboard-header">
            <h1>Panel de Control</h1>
            <p>Última actualización: 15 de Octubre a las 10:45 AM</p>
        </div>

        <div class="dashboard-grid">
            <!-- Card 1: Incidentes Recientes -->
            <div class="card">
                <div>
                    <div class="card-header">
                        <h2>Incidentes Recientes</h2>
                        <div class="icon">
                            <a class="icon-link" href="#" aria-label="Ver reportes recientes">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                </svg>
                            </a>
                        </div>
                    </div>
                    <p class="main-stat">5</p>
                    <ul class="incident-list">
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.21 3.031-1.742 3.031H4.42c-1.532 0-2.492-1.697-1.742-3.031l5.58-9.92zM10 13a1 1 0 110-2 1 1 0 010 2zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            <span>Robo en Calle Picsi 123 - 14:30</span>
                        </li>
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
                            </svg>
                            <span>Actividad Sospechosa en Parque TingLing - 11:15h</span>
                        </li>
                    </ul>
                </div>
                <p class="card-footer-text">en las últimas 24h</p>
            </div>

            <!-- Card 2: Alertas Activas -->
            <div class="card alerts">
                <div>
                    <div class="card-header">
                        <h2>Alertas Activas</h2>
                        <div class="icon">
                            <a class="icon-link" href="#" aria-label="Ver alertas activas">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                </svg>
                            </a>
                        </div>
                    </div>
                    <p class="main-stat">2</p>
                </div>
                <button class="manage-button">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Gestionar ahora</span>
                </button>
            </div>

            <!-- Card 3: Participación Vecinal -->
            <div class="card">
                <div>
                    <div class="card-header">
                        <h2>Participación Vecinal</h2>
                        <div class="icon">
                             <a class="icon-link" href="#" aria-label="Ver participación vecinal">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                   <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                </svg>
                             </a>
                        </div>
                    </div>
                    <div class="participation-stat">
                        <p class="percentage">75%</p>
                        <p class="change">+5%</p>
                    </div>
                    <div class="progress-circle-container">
                        <svg class="w-full h-full" viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="40" fill="transparent" stroke="#e5e7eb" stroke-width="10"></circle>
                            <circle cx="50" cy="50" r="40" fill="transparent" stroke="#39716C" stroke-width="10" stroke-linecap="round" stroke-dasharray="251.3" stroke-dashoffset="62.8" transform="rotate(-90 50 50)"></circle>
                        </svg>
                        <div class="progress-circle-text">
                            <span class="value">150</span>
                            <span class="label">Activos</span>
                        </div>
                    </div>
                </div>
                <p class="card-footer-text center">150 de 200 vecinos activos</p>
            </div>

            <!-- Card 4: Tendencia de incidentes (HU41) -->
            <div class="card trend-card">
                <div class="card-header">
                    <div class="title-with-icon">
                        <svg class="trend-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3V21H21" stroke="#1C2542" stroke-width="2" stroke-linecap="round"/>
                            <path d="M7 15L11 11L15 13L19 7" stroke="#39716C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <h2>Tendencia de incidentes</h2>
                    </div>
                    <div class="icon">
                        <a class="icon-link trend-more-btn" href="#" aria-label="Ver más información de tendencia">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="trend-highlights">
                    <div class="th-item"><span class="th-label">Periodo actual</span><span class="th-value">22</span></div>
                    <div class="th-item"><span class="th-label">Máximo (año)</span><span class="th-value">2025</span></div>
                    <div class="th-item"><span class="th-label">Cambio</span><span class="th-value">+12%</span></div>
                </div>
                <div class="trend-mini">
                    <div class="trend-mini-bar" style="height: 30%"></div>
                    <div class="trend-mini-bar" style="height: 40%"></div>
                    <div class="trend-mini-bar" style="height: 65%"></div>
                    <div class="trend-mini-bar" style="height: 18%"></div>
                    <div class="trend-mini-bar" style="height: 22%"></div>
                </div>
            </div>
        </div>
    </main>
